# Staging / demo server (aaPanel). Copy to the project root as .env.local and fill in.
# Never commit the real file.

NODE_ENV=production
# Demo server for client testing: allows PAYMENTS_MODE=demo, shows a "Demo site" banner, hides from search engines.
DEPLOY_ENV=staging
PAYMENTS_MODE=demo

# Public URL of this server (https — the scanner camera needs it).
APP_URL=https://events.neelshah.co
BETTER_AUTH_URL=https://events.neelshah.co
# Port the web app listens on (127.0.0.1 only; Nginx proxies to it). Must match proxy_pass in deploy/nginx-aapanel.conf.
PORT=3005

# MongoDB Atlas: use a SEPARATE database for staging (note the name before "?").
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/indinite-events-staging?retryWrites=true&w=majority

# Generate each with: openssl rand -base64 48
BETTER_AUTH_SECRET=
LINK_SIGNING_SECRET=

# QR keys: pnpm --filter @indinite/core gen:qr-keys  (new keys for this server; don't reuse dev keys)
QR_SIGNING_PRIVATE_KEY=
NEXT_PUBLIC_QR_PUBLIC_KEY=

# Email: the sending domain (events.neelshah.co) must be verified in Resend → Domains
RESEND_API_KEY=re_
EMAIL_FROM="Indinite Events <tickets@events.neelshah.co>"

# Uploaded images: keep OUTSIDE the project folder so deploys never touch them.
MEDIA_DIR=/www/wwwroot/indinite-media

# Staging seed accounts' password (pnpm seed / deploy.sh --seed). Set your own; share only with testers.
# The seeds only run with DEPLOY_ENV=staging (above); on the live server they refuse.
SEED_PASSWORD=

# Stripe (not used while PAYMENTS_MODE=demo)
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint for events on Indinite's own account.
STRIPE_WEBHOOK_SECRET=
# "Connect your existing Stripe account" (optional): Connect → Settings → OAuth client id (ca_…), and the signing
# secret of a second webhook endpoint (same URL, "Events on Connected accounts"). See docs/DEPLOY-AAPANEL.md.
STRIPE_CONNECT_CLIENT_ID=
STRIPE_CONNECT_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Company details shown in the privacy policy, booking terms and refund policy (fill in before launch)
LEGAL_ENTITY_NAME=
LEGAL_ICO_NUMBER=
LEGAL_SUPPORT_EMAIL=contact@indinite.co.uk
LEGAL_PRIVACY_EMAIL=privacy@indinite.co.uk

# Load testing only (e2e/tests/load.ts): raise the per-IP checkout limit while a test runs, then remove it.
# LOAD_TEST_CHECKOUT_LIMIT=100000
