{
  "name": "@indinite/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests --exclude '**/*.db.test.ts'",
    "test:db": "vitest run db.test",
    "sync-indexes": "tsx --env-file-if-exists=../../.env.local scripts/sync-indexes.ts",
    "seed": "tsx --env-file-if-exists=../../.env.local scripts/seed.ts",
    "requeue-failed-jobs": "tsx --env-file-if-exists=../../.env.local scripts/requeue-failed-jobs.ts",
    "backfill-pass-codes": "tsx --env-file-if-exists=../../.env.local scripts/backfill-pass-codes.ts",
    "check-env": "tsx --env-file-if-exists=../../.env.local scripts/check-env.ts",
    "funnel": "tsx --env-file-if-exists=../../.env.local scripts/funnel.ts",
    "meta-backfill-purchases": "tsx --env-file-if-exists=../../.env.local scripts/meta-backfill-purchases.ts",
    "webhooks-failed": "tsx --env-file-if-exists=../../.env.local scripts/webhooks-failed.ts"
  },
  "dependencies": {
    "@indinite/core": "workspace:*",
    "mongoose": "^8.7.0",
    "stripe": "^22.6.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "mongodb-memory-server": "^10.1.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
