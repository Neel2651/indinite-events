{
  "name": "@indinite/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests --exclude '**/*.db.test.ts'",
    "test:db": "vitest run db.test",
    "sync-indexes": "tsx scripts/sync-indexes.ts",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@indinite/core": "workspace:*",
    "mongoose": "^8.7.0",
    "bullmq": "^6.3.9",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "mongodb-memory-server": "^10.1.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}