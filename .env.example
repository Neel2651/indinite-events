# App
APP_URL=http://localhost:3000
NODE_ENV=development

# Database / cache
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/indinite_events?retryWrites=true&w=majority
REDIS_URL=rediss://default:PASS@HOST:6379

# Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Stripe (test mode first)
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_

# Email
RESEND_API_KEY=re_
EMAIL_FROM="Indinite Events <tickets@events.indinite.co.uk>"

# QR signing (Ed25519, 32-byte keys as hex — generate with: pnpm --filter @indinite/core gen:qr-keys)
QR_SIGNING_PRIVATE_KEY=
NEXT_PUBLIC_QR_PUBLIC_KEY=

# Media
S3_BUCKET=
S3_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLOUDFRONT_URL=

# Monitoring
SENTRY_DSN=
