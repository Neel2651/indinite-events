# App
APP_URL=http://localhost:3000
NODE_ENV=development
# Port for `next start` / PM2 (default 3005).
# PORT=3005
# "staging" marks a demo server for client testing: allows PAYMENTS_MODE=demo and the demo seed scripts
# (pnpm seed, seed-users, deploy.sh --seed) on a production build. Leave unset on the live server, where the
# seeds refuse to run; set up a live database with `pnpm setup:production <admin email>` instead.
# DEPLOY_ENV=staging

# Database
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/indinite_events?retryWrites=true&w=majority

# Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Payments: "stripe" (default) or "demo" — demo skips Stripe and approves orders instantly.
# Development, or a staging server with DEPLOY_ENV=staging; refused on a live server.
PAYMENTS_MODE=stripe

# Stripe (test mode first)
STRIPE_SECRET_KEY=sk_test_
# Signing secret of the webhook endpoint for events on Indinite's own account.
STRIPE_WEBHOOK_SECRET=whsec_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
# "Connect your existing Stripe account" for organisers (optional; the button is hidden until set).
# Client ID: Stripe → Connect → Settings → Onboarding options → OAuth (starts ca_). Redirect URI to add there:
# <APP_URL>/api/stripe/connect/callback
STRIPE_CONNECT_CLIENT_ID=ca_
# Signing secret of a second webhook endpoint, same URL, "Events on Connected accounts" (docs/DEPLOY-AAPANEL.md).
# Locally, `stripe listen --forward-connect-to …` uses the same secret as STRIPE_WEBHOOK_SECRET.
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_

# Signs customer "View tickets" links (30 min). Generate: openssl rand -base64 48
LINK_SIGNING_SECRET=

# Email
RESEND_API_KEY=re_
EMAIL_FROM="Indinite Events <tickets@events.indinite.co.uk>"

# QR signing (Ed25519, 32-byte keys as hex — generate with: pnpm --filter @indinite/core gen:qr-keys)
QR_SIGNING_PRIVATE_KEY=
NEXT_PUBLIC_QR_PUBLIC_KEY=

# Media (uploaded images, stored on the app server's disk)
MEDIA_DIR=./storage/media

# Password for the demo seed accounts (pnpm --filter @indinite/auth seed-users). Development / staging only.
SEED_PASSWORD=

# First super admin on a new database: `pnpm setup:production admin@indinite.co.uk` asks for the password.
# To run it without a prompt, pass it for that one command only (don't keep it in this file):
#   ADMIN_PASSWORD='…' pnpm setup:production admin@indinite.co.uk

# Company details shown in the privacy policy, booking terms and refund policy (fill in before launch)
LEGAL_ENTITY_NAME=
LEGAL_ICO_NUMBER=
LEGAL_SUPPORT_EMAIL=contact@indinite.co.uk
LEGAL_PRIVACY_EMAIL=privacy@indinite.co.uk
