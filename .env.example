# App
APP_URL=http://localhost:3000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/indinite_events?retryWrites=true&w=majority

# Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Payments: "stripe" (default) or "demo" — demo skips Stripe and approves orders instantly.
# Development, or a staging server with DEPLOY_ENV=staging; refused on a live server.
PAYMENTS_MODE=stripe

# Stripe (test mode first)
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_

# Signs customer "View tickets" links (30 min). Generate: openssl rand -base64 48
LINK_SIGNING_SECRET=

# Email
RESEND_API_KEY=re_
EMAIL_FROM="Indinite Events <tickets@events.indinite.co.uk>"

# QR signing (Ed25519, 32-byte keys as hex — generate with: pnpm --filter @indinite/core gen:qr-keys)
QR_SIGNING_PRIVATE_KEY=
NEXT_PUBLIC_QR_PUBLIC_KEY=

# Media (uploaded images, stored on the app server's disk)
MEDIA_DIR=./storage/media
