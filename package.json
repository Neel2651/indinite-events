{
  "name": "indinite-events",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "seed": "pnpm --filter @indinite/db seed && pnpm --filter @indinite/auth seed-users",
    "format": "prettier --write .",
    "setup:production": "pnpm --filter @indinite/db sync-indexes && pnpm --filter @indinite/auth sync-indexes && pnpm --filter @indinite/auth create-super-admin",
    "check:env": "pnpm --filter @indinite/db check-env",
    "owners": "pnpm --filter @indinite/auth owners"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "eslint-config-next": "^16",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.12.0",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.1"
  }
}
